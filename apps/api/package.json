{
  "name": "@aethina/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:dev": "nest start --watch",
    "build": "nest build",
    "build:vercel": "tsc -p tsconfig.vercel.json --noEmit",
    "test": "vitest run",
    "prisma:generate": "tsx scripts/run-prisma.ts generate",
    "prisma:migrate": "tsx scripts/run-prisma.ts migrate dev --name init",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:reset:dev": "tsx scripts/reset-dev-db.ts",
    "offline:test": "vitest run test/offline-sync.test.ts",
    "offline:smoke": "tsx scripts/offline-smoke.ts",
    "acceptance:phase1": "tsx scripts/phase1-acceptance-execution.ts"
  },
  "dependencies": {
    "@aethina/shared-types": "0.1.0",
    "@aethina/validation": "0.1.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "^6.13.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/node": "^24.2.1",
    "prisma": "^6.13.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
